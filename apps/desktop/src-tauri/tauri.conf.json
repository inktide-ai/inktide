{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inktide",
  "version": "0.1.0",
  "identifier": "ai.inktide.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Inktide",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: https: blob: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5000 http://127.0.0.1:5000 http://localhost:8080 ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "title": "Inktide",
      "tooltip": "Inktide — AI companion for streaming"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["inktide"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
