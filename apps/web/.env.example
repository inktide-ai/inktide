# Base URL for API requests.
# Leave empty (default) when the frontend and backend are on the same domain
# and the backend is reachable via /api (handled by Vite proxy in dev or Nginx in prod).
# Set to a full URL when using a separate API domain, e.g.:
# VITE_API_URL=https://api.chimera.gg
VITE_API_URL=

# Keycloak (public SPA client)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chimera
VITE_KEYCLOAK_CLIENT_ID=chimera-web
