# Chimera.Identity.API - Environment variables
# Copy to .env and fill in values. Loaded automatically at startup via DotNetEnv.

# ============== Auth ==============
# JWT signing secret (min 32 chars). Required.
AuthSettings__Secret=your-super-secret-key-at-least-32-characters-long
# Dev API key for testing (optional)
# AuthSettings__DevApiKey=dev-api-key-for-testing

# ============== PostgreSQL ==============
PostgresSettings__Host=localhost
PostgresSettings__Port=5432
PostgresSettings__Database=chimera
PostgresSettings__Username=chimera
PostgresSettings__Password=your-password

# Or full connection string:
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=chimera;Username=chimera;Password=xxx

# ============== Redis ==============
RedisSettings__BaseAddress=127.0.0.1
RedisSettings__BasePort=6379

# ============== SMTP ==============
SmtpSettings__Host=localhost
SmtpSettings__Port=1025
SmtpSettings__EnableSsl=false
