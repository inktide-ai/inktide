{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/Gateway/chimera-api-gateway-.log",
          "formatter": "Chimera.ApiGateway.Core.Logging.CustomCompactJsonFormatter, Chimera.ApiGateway.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "chimera-api-gateway" }
          ],
          "propertiesAsLabels": ["SourceContext"]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  "AuthSettings": {
    "Issuer": "Chimera.ApiGateway",
    "Audience": "Chimera.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "BcryptWorkFactor": 12,
    "EnableDemoLogin": false
  },
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordResetTokenMinutes": 60
  },
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@chimera.local",
    "FromName": "Chimera"
  },
  "ThreadPool": {
    "MinWorkerThreads": 100,
    "MinIoThreads": 100
  },
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8080,
    "MaxConcurrentConnections": 0,
    "MaxConcurrentUpgradedConnections": 100
  },
  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081
  },
  "Modules": {
    "Infrastructure": {
      "AssemblyName": "Chimera.ApiGateway.Infrastructure.dll",
      "Enabled": true
    },
    "RESTAPI": {
      "AssemblyName": "Chimera.ApiGateway.REST.API.dll",
      "Enabled": true
    },
    "Grpc": {
      "AssemblyName": "Chimera.ApiGateway.Grpc.dll",
      "Enabled": true
    },
    "GrpcAuth": {
      "AssemblyName": "Chimera.ApiGateway.Grpc.Auth.dll",
      "Enabled": true
    },
    "Twitch": {
      "AssemblyName": "Chimera.ApiGateway.Twitch.dll",
      "Enabled": false
    },
    "Discord": {
      "AssemblyName": "Chimera.ApiGateway.Discord.dll",
      "Enabled": true
    }
  },
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "chimera.streaming",
    "RoutingKey": "chat.message",
    "QueueName": "stream_input"
  },
  "DiscordSettings": {
    "GuildIds": [],
    "ChannelIds": [],
    "IgnoreBots": true,
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  },
  "ObservabilitySettings": {
    "ServiceName": "chimera-api-gateway",
    "OtlpEndpoint": "http://localhost:4317",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "TwitchSettings": {
    "ClientId": "",
    "ClientSecret": "",
    "AccessToken": "",
    "BroadcasterUserId": "",
    "UserId": "",
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  }
}