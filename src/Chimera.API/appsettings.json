{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Chimera.API.Core"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/API/chimera-api-.log",
          "formatter": "Chimera.API.Core.Logging.CustomCompactJsonFormatter, Chimera.API.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  
  "ChatProviders": {
    "DefaultProviderId": "echo",
    "FeatureFlags": {}
  },

  "TtsProviders": {
    "DefaultProviderId": "kokoro",
    "FeatureFlags": {},
    "Kokoro": {
      "Endpoint": "http://127.0.0.1:8880/v1"
    },
    "ElevenLabs": {
      "Endpoint": "https://api.elevenlabs.io",
      "DefaultModelId": "eleven_multilingual_v2"
    },
    "AzureSpeech": {
      "DefaultRegion": "eastus"
    },
    "GoogleCloudTts": {},
    "Cartesia": {
      "DefaultModel": "sonic-2"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5001"
      }
    }
  },

  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081,
    "CertPath": "",
    "CertPassword": ""
  },

  "SoulGrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8084,
    "CertPath": "",
    "CertPassword": ""
  },
  
  "Modules": {
    "Connector.Infrastructure": {
      "AssemblyName": "Chimera.API.Connector.Infrastructure.dll",
      "Enabled": true
    },
    "Connector.Discord": {
      "AssemblyName": "Chimera.API.Connector.Discord.dll",
      "Enabled": true
    },
    "Connector.ChimeraChat": {
      "AssemblyName": "Chimera.API.Connector.ChimeraChat.dll",
      "Enabled": true
    },
    "Synapse.Infrastructure": {
      "AssemblyName": "Chimera.API.Synapse.Infrastructure.dll",
      "Enabled": true
    },
    "Synapse.REST": {
      "AssemblyName": "Chimera.API.Synapse.REST.dll",
      "Enabled": true
    },
    "Profile.Application": {
      "AssemblyName": "Chimera.API.Profile.Application.dll",
      "Enabled": true
    },
    "Profile.Infrastructure": {
      "AssemblyName": "Chimera.API.Profile.Infrastructure.dll",
      "Enabled": true
    },
    "Profile.REST": {
      "AssemblyName": "Chimera.API.Profile.REST.dll",
      "Enabled": true
    },
    "Soul.Application": {
      "AssemblyName": "Chimera.API.Soul.Application.dll",
      "Enabled": true
    },
    "Soul.Infrastructure": {
      "AssemblyName": "Chimera.API.Soul.Infrastructure.dll",
      "Enabled": true
    },
    "Soul.REST": {
      "AssemblyName": "Chimera.API.Soul.REST.dll",
      "Enabled": true
    },
    "Soul.Grpc": {
      "AssemblyName": "Chimera.API.Soul.Grpc.dll",
      "Enabled": true
    },
    "Soul.Grpc.AiCards.Service": {
      "AssemblyName": "Chimera.API.Soul.Grpc.AiCards.Service.dll",
      "Enabled": true
    },
    "TTS.Application": {
      "AssemblyName": "Chimera.API.TTS.Application.dll",
      "Enabled": true
    },
    "TTS.Infrastructure": {
      "AssemblyName": "Chimera.API.TTS.Infrastructure.dll",
      "Enabled": true
    },
    "TTS.REST": {
      "AssemblyName": "Chimera.API.TTS.REST.dll",
      "Enabled": true
    },
    "Memory.Infrastructure": {
      "AssemblyName": "Chimera.API.Memory.Infrastructure.dll",
      "Enabled": true
    },
    "Realtime.Infrastructure": {
      "AssemblyName": "Chimera.API.Realtime.Infrastructure.dll",
      "Enabled": true
    }
  },

  "RealtimeTextStream": {
    "StreamName": "synapse.llm.response",
    "ConsumerGroup": "text-delivery-workers"
  },
  
  "KeycloakSettings": {
    "Authority": "http://localhost:8080/realms/chimera",
    "Audience": "account",
    "RequireHttpsMetadata": false
  },

  "KeycloakAdminSettings": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8080",
    "Realm": "chimera-backend-admin",
    "ClientId": "CHANGE_ME__KEYCLOAK_ADMIN_CLIENT_ID",
    "ClientSecret": "CHANGE_ME__KEYCLOAK_ADMIN_CLIENT_SECRET"
  },

  "S3Settings": {
    "Enabled": true,
    "PublicBaseUrl": "",
    "ServiceUrl": "http://127.0.0.1:9000",
    "AccessKey": "CHANGE_ME__MINIO_ACCESS_KEY",
    "SecretKey": "CHANGE_ME__MINIO_SECRET_KEY",
    "DefaultBucket": "chimera-uploads",
    "ForcePathStyle": true,
    "Region": "us-east-1"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:1420",
      "tauri://localhost"
    ]
  },
  
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "CHANGE_ME__POSTGRES_DATABASE",
    "Username": "CHANGE_ME__POSTGRES_USERNAME",
    "Password": "CHANGE_ME__POSTGRES_PASSWORD",
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  
  "SynapseIngestStreamSettings": {
    "StreamName": "synapse.ingest",
    "ConsumerGroup": "pipeline-workers",
    "ConsumerNamePrefix": "pipeline",
    "PayloadFieldName": "payload",
    "ApproximateMaxLength": 50000,
    "ReadBlockMilliseconds": 2000,
    "ReadCount": 16,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 50,
    "AutoClaimLoopDelaySeconds": 30
  },

  "DiscordSettings": {
    "BotToken": "CHANGE_ME__DISCORD_BOT_TOKEN",
    "GuildIds": [],
    "ChannelIds": [],
    "IgnoreBots": true,
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  },

  "OllamaSettings": {
    "Host": "http://localhost",
    "Port": 11434,
    "EmbeddingModel": "nomic-embed-text"
  },
  
  "QdrantSettings": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "chat_memories",
    "VectorSize": 768
  },

  "MemorySettings": {
    "TopK": 5,
    "MaxHistoryTurns": 30,
    "IngestionBatchSize": 5,
    "IngestionBatchWindowMs": 3000,
    "IngestionChannelCapacity": 500,
    "RetentionDays": 90,
    "MinImportanceThreshold": 0.3,
    "ScribeBaseUrl": "http://localhost:8001"
  },

  "SynapseSettings": {
    "MaxHistoryTurns": 30
  },

  "SynapseAggregation": {
    "LlmStreamName": "synapse.llm.ready",
    "ApproximateMaxLength": 10000
  },

  "LlmResponseStream": {
    "StreamName": "synapse.llm.response",
    "ConsumerGroup": "tts-workers",
    "ConsumerNamePrefix": "tts",
    "PayloadFieldName": "payload",
    "ReadCount": 8,
    "ReadBlockMilliseconds": 2000,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 20,
    "AutoClaimLoopDelaySeconds": 30,
    "DefaultVoiceId": "af_heart"
  },

  "TtsOutputStream": {
    "StreamName": "synapse.tts.ready",
    "ApproximateMaxLength": 5000,
    "PayloadFieldName": "payload"
  }


}