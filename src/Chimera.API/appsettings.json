{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Chimera.API.Core"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/API/chimera-api-.log",
          "formatter": "Chimera.API.Core.Logging.CustomCompactJsonFormatter, Chimera.API.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8080,
    "MaxConcurrentConnections": 0,
    "MaxConcurrentUpgradedConnections": 100
  },

  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081,
    "CertPath": "",
    "CertPassword": ""
  },

  "SoulGrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8084,
    "CertPath": "",
    "CertPassword": ""
  },
  
  "Modules": {
    "Identify.Application": {
      "AssemblyName": "Chimera.API.Identify.Application.dll",
      "Enabled": true
    },
    "Identify.Infrastructure": {
      "AssemblyName": "Chimera.API.Identify.Infrastructure.dll",
      "Enabled": true
    },
    "Identify.REST": {
      "AssemblyName": "Chimera.API.Identify.REST.dll",
      "Enabled": true
    },
    "Identify.Grpc": {
      "AssemblyName": "Chimera.API.Identify.Grpc.dll",
      "Enabled": true
    },
    "Identify.Grpc.Auth.Service": {
      "AssemblyName": "Chimera.API.Identify.Grpc.Auth.Service.dll",
      "Enabled": true
    },
    "Connector.Infrastructure": {
      "AssemblyName": "Chimera.API.Connector.Infrastructure.dll",
      "Enabled": true
    },
    "Connector.Discord": {
      "AssemblyName": "Chimera.API.Connector.Discord.dll",
      "Enabled": true
    },
    "Synapse.Infrastructure": {
      "AssemblyName": "Chimera.API.Synapse.Infrastructure.dll",
      "Enabled": true
    },
    "Soul.Application": {
      "AssemblyName": "Chimera.API.Soul.Application.dll",
      "Enabled": true
    },
    "Soul.Infrastructure": {
      "AssemblyName": "Chimera.API.Soul.Infrastructure.dll",
      "Enabled": true
    },
    "Soul.REST": {
      "AssemblyName": "Chimera.API.Soul.REST.dll",
      "Enabled": true
    },
    "Soul.Grpc": {
      "AssemblyName": "Chimera.API.Soul.Grpc.dll",
      "Enabled": true
    },
    "Soul.Grpc.AiCards.Service": {
      "AssemblyName": "Chimera.API.Soul.Grpc.AiCards.Service.dll",
      "Enabled": true
    }
  },
  
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  
  "OAuthSettings": {
    "FrontendBaseUrl": "http://localhost:5173",
    "FrontendCallbackPath": "/auth/callback",
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    },
    "Twitch": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "AuthSettings": {
    "Issuer": "Chimera.API",
    "Audience": "Chimera.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "BcryptWorkFactor": 12,
    "EnableDemoLogin": false
  },
  
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordResetTokenMinutes": 60
  },
  
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@chimera.local",
    "FromName": "Chimera"
  },
  
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "chimera.streaming",
    "RoutingKey": "chat.message",
    "QueueName": "stream_input"
  },
  
  "DiscordSettings": {
    "GuildIds": [],
    "ChannelIds": [],
    "IgnoreBots": true,
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  },

  "OllamaSettings": {
    "Host": "http://localhost",
    "Port": 11434,
    "EmbeddingModel": "nomic-embed-text"
  },
  
  "QdrantSettings": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "chat_memories",
    "VectorSize": 768
  }
}