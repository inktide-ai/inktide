{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/Orchestrator/ai-orchestrator-.log",
          "formatter": "Chimera.AI.Orchestrator.Core.Logging.CustomCompactJsonFormatter, Chimera.AI.Orchestrator.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId"
    ]
  },
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 9090
  },
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "chimera.streaming",
    "RoutingKey": "chat.message",
    "QueueName": "stream_input",
    "PrefetchCount": 64
  },
  "OllamaSettings": {
    "Host": "http://localhost",
    "Port": 11434,
    "EmbeddingModel": "nomic-embed-text"
  },
  "QdrantSettings": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "chat_memories",
    "VectorSize": 768
  },
  "Modules": {
    "Infrastructure": {
      "AssemblyName": "Chimera.AI.Orchestrator.Infrastructure.dll",
      "Enabled": true
    }
  }
}
