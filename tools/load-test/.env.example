# Copy to tools/load-test/.env and fill in. scripts/run.sh auto-loads this file.
# Env values override config/profiles/*.json where applicable.

# ── Target ────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:5001
# Derived from BASE_URL when empty (http→ws).
#WS_URL=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_URL=http://localhost:8080
KC_REALM=chimera
KC_CLIENT_ID=chimera-web
# Password shared by every bench-user-NNNN (seeding, token fetch, k6 refresh).
BENCH_USER_PASSWORD=
# Admin credentials for user seeding — local: matches KEYCLOAK_ADMIN in root .env.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# Staging alternative: confidential client with manage-users (instead of admin login).
#KC_ADMIN_CLIENT_ID=
#KC_ADMIN_CLIENT_SECRET=

# ── Load shape ────────────────────────────────────────────────────────────────
# smoke | baseline | stress | spike | soak | limits (see config/profiles/).
PROFILE=smoke
# Overrides the profile's userPool.size. More users = more headroom under the
# 300 req/min/user limit; preflight.mjs enforces the math.
#USER_POOL_SIZE=

# ── Chat E2E ──────────────────────────────────────────────────────────────────
# Soul card id for the chatE2E scenario (create one: node scripts/seed-card.mjs).
CHAT_CARD_ID=
# http = POST /api/v1/connectors/inktide/messages (default, user-facing path)
# redis = XADD to synapse.ingest (pipeline-bench semantics, needs REDIS_URL)
CHAT_INJECTOR=http
#REDIS_URL=redis://localhost:6379

# ── TTS ───────────────────────────────────────────────────────────────────────
#TTS_PROVIDER_ID=kokoro
#TTS_VOICE_ID=af_bella
# When set, GET /tts/voices?provider_id=… joins the public mix (proxies live to
# that provider — leave empty unless the workers profile is running).
#TTS_VOICES_PROVIDER=kokoro

# ── Optional integrations ─────────────────────────────────────────────────────
# 1 = include POST /demo/chat in the public mix (needs Ollama on the host).
DEMO_LLM=0
# k6 → Prometheus remote write. With the compose bench profile up:
#PROM_RW_URL=http://localhost:9090/api/v1/write
