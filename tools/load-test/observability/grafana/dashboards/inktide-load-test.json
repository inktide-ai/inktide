{
  "title": "Inktide · Load Test",
  "uid": "inktide-load-test",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": ["load-test", "k6"],
  "panels": [
    {
      "type": "row",
      "title": "k6 · client-side",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by scenario",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (scenario) (rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "{{scenario}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 / p99 by scenario",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "max by (scenario) (k6_http_req_duration_p95)", "legendFormat": "p95 {{scenario}}" },
        { "expr": "max by (scenario) (k6_http_req_duration_p99)", "legendFormat": "p99 {{scenario}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate / checks",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "k6_http_req_failed_rate", "legendFormat": "http_req_failed" },
        { "expr": "k6_checks_rate", "legendFormat": "checks pass" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active VUs",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "k6_vus", "legendFormat": "VUs" }]
    },
    {
      "type": "timeseries",
      "title": "429 rate (rate-limiter pressure)",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "k6_anon_429_rate", "legendFormat": "anonymous" },
        { "expr": "k6_crud_429_rate", "legendFormat": "authenticated crud" },
        { "expr": "k6_tts_429_rate", "legendFormat": "tts" }
      ]
    },
    {
      "type": "timeseries",
      "title": "TTS: time to first byte / total (p95)",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "k6_tts_ttfb_ms_p95", "legendFormat": "TTFB p95" },
        { "expr": "k6_tts_total_ms_p95", "legendFormat": "total p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chat E2E latency (p95) — SLO 4000ms",
      "description": "publish → first textChunk / first audioReceived / audioReceived.isLast over SignalR",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 4000 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "k6_chat_first_token_ms_p95", "legendFormat": "first token p95" },
        { "expr": "k6_chat_first_audio_ms_p95", "legendFormat": "first audio p95" },
        { "expr": "k6_chat_total_ms_p95", "legendFormat": "total p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chat E2E failures",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "k6_chat_slo_violations_rate", "legendFormat": "SLO violations (>4s)" },
        { "expr": "k6_chat_timeouts_rate", "legendFormat": "timeouts (30s)" },
        { "expr": "k6_signalr_handshake_ok_rate", "legendFormat": "handshake ok" }
      ]
    },
    {
      "type": "row",
      "title": "API · server-side (/metrics)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Server p95 by route",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server request rate by status",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server request rate by route",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "synapse_e2e_latency_ms p95 (server-side SLO)",
      "description": "Instrument is DEFINED but not yet recorded by the API (see ObservabilityStartup.cs). This panel lights up once the API wires it.",
      "datasource": { "type": "prometheus", "uid": "prometheus-bench" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 4000 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(synapse_e2e_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
