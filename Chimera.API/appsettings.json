{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Chimera.API.Core"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/API/chimera-api-.log",
          "formatter": "Chimera.API.Core.Logging.CustomCompactJsonFormatter, Chimera.API.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 5000,
    "MaxConcurrentConnections": 0,
    "MaxConcurrentUpgradedConnections": 100
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },

  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081,
    "CertPath": "",
    "CertPassword": ""
  },

  "SoulGrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8084,
    "CertPath": "",
    "CertPassword": ""
  },
  
  "Modules": {
    "Connector.Infrastructure": {
      "AssemblyName": "Chimera.API.Connector.Infrastructure.dll",
      "Enabled": true
    },
    "Connector.Discord": {
      "AssemblyName": "Chimera.API.Connector.Discord.dll",
      "Enabled": true
    },
    "Synapse.Infrastructure": {
      "AssemblyName": "Chimera.API.Synapse.Infrastructure.dll",
      "Enabled": true
    },
    "Profile.Application": {
      "AssemblyName": "Chimera.API.Profile.Application.dll",
      "Enabled": true
    },
    "Profile.Infrastructure": {
      "AssemblyName": "Chimera.API.Profile.Infrastructure.dll",
      "Enabled": true
    },
    "Profile.REST": {
      "AssemblyName": "Chimera.API.Profile.REST.dll",
      "Enabled": true
    },
    "Soul.Application": {
      "AssemblyName": "Chimera.API.Soul.Application.dll",
      "Enabled": true
    },
    "Soul.Infrastructure": {
      "AssemblyName": "Chimera.API.Soul.Infrastructure.dll",
      "Enabled": true
    },
    "Soul.REST": {
      "AssemblyName": "Chimera.API.Soul.REST.dll",
      "Enabled": true
    },
    "Soul.Grpc": {
      "AssemblyName": "Chimera.API.Soul.Grpc.dll",
      "Enabled": true
    },
    "Soul.Grpc.AiCards.Service": {
      "AssemblyName": "Chimera.API.Soul.Grpc.AiCards.Service.dll",
      "Enabled": true
    }
  },
  
  "KeycloakSettings": {
    "Authority": "http://localhost:8080/realms/chimera-app",
    "Audience": "account",
    "RequireHttpsMetadata": false
  },

  "KeycloakAdminSettings": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8080",
    "Realm": "chimera-app",
    "ClientId": "",
    "ClientSecret": ""
  },

  "S3Settings": {
    "Enabled": false,
    "PublicBaseUrl": "",
    "ServiceUrl": "http://127.0.0.1:9000",
    "AccessKey": "",
    "SecretKey": "",
    "DefaultBucket": "chimera-uploads",
    "ForcePathStyle": true,
    "Region": "us-east-1"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  
  "OAuthSettings": {
    "FrontendBaseUrl": "http://localhost:5173",
    "FrontendCallbackPath": "/auth/callback",
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    },
    "Twitch": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "AuthSettings": {
    "Issuer": "Chimera.API",
    "Audience": "Chimera.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "BcryptWorkFactor": 12,
    "EnableDemoLogin": false
  },
  
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordResetTokenMinutes": 60
  },
  
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@chimera.local",
    "FromName": "Chimera"
  },
  
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "chimera.streaming",
    "RoutingKey": "chat.message",
    "QueueName": "stream_input"
  },
  
  "DiscordSettings": {
    "GuildIds": [],
    "ChannelIds": [],
    "IgnoreBots": true,
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  },

  "OllamaSettings": {
    "Host": "http://localhost",
    "Port": 11434,
    "EmbeddingModel": "nomic-embed-text"
  },
  
  "QdrantSettings": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "chat_memories",
    "VectorSize": 768
  }
}