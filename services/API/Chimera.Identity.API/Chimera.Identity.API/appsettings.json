{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/API/chimera-identify-api-.log",
          "formatter": "Chimera.Identity.API.Core.Logging.CustomCompactJsonFormatter, Chimera.Identity.API.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  "AuthSettings": {
    "Issuer": "Chimera.Identify.API",
    "Audience": "Chimera.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "BcryptWorkFactor": 12,
    "EnableDemoLogin": false
  },
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordResetTokenMinutes": 60
  },
  "SmtpSettings": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "noreply@chimera.local",
    "FromName": "Chimera"
  },
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8082,
    "MaxConcurrentConnections": 0,
    "MaxConcurrentUpgradedConnections": 100
  },
  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081
  },
  "Modules": {
    "Infrastructure": {
      "AssemblyName": "Chimera.Identity.Infrastructure.dll",
      "Enabled": true
    },
    "RESTAPI": {
      "AssemblyName": "Chimera.Identity.API.REST.dll",
      "Enabled": true
    },
    "Grpc": {
      "AssemblyName": "Chimera.Identity.API.Grpc.dll",
      "Enabled": true
    },
    "GrpcAuth": {
      "AssemblyName": "Chimera.Identity.API.Grpc.Auth.dll",
      "Enabled": true
    }
  },
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  }
}