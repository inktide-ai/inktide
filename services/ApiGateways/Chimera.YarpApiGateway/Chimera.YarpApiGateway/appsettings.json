{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/Gateway/chimera-yarp-api-gateway-.log",
          "formatter": "Chimera.YarpApiGateway.Logging.CustomCompactJsonFormatter, Chimera.YarpApiGateway",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "chimera-api-gateway" }
          ],
          "propertiesAsLabels": ["SourceContext"]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "Server": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8080,
    "MaxConcurrentConnections": 0,
    "MaxConcurrentUpgradedConnections": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity-api",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-me": {
        "ClusterId": "identity-api",
        "Match": {
          "Path": "/api/me"
        }
      },
      "identity-health": {
        "ClusterId": "identity-api",
        "Match": {
          "Path": "/health"
        }
      }
    },
    "Clusters": {
      "identity-api": {
        "Destinations": {
          "default": {
            "Address": "http://127.0.0.1:8082"
          }
        }
      }
    }
  },
  "ObservabilitySettings": {
    "ServiceName": "chimera-yarp-api-gateway",
    "OtlpEndpoint": "http://localhost:4317",
    "EnableTracing": true,
    "EnableMetrics": true
  }
}