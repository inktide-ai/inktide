{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "KeycloakSettings": {
    "RequireHttpsMetadata": true
  },

  "PostgresSettings": {
    "MaxPoolSize": 50,
    "MinPoolSize": 5
  },

  "CorsSettings": {
    "AllowedOrigins": []
  }
}
