  "ScreenAwareness": {
    "Enabled": true,
    "VisionProvider": "ollama",
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaVisionModel": "llava:7b",
    "AnthropicApiKey": "",
    "AnthropicModel": "claude-haiku-4-5",
    "PHashThresholdDefault": 10,
    "FreePlanHourlyBudget": 300,
    "ProPlanHourlyBudget": 5000,
    "VisionTimeoutMs": 5000,
    "ContextWindowSeconds": 60
  },

  "ScreenFrameStream": {
    "StreamName": "screen.frames.pending",
    "ConsumerGroup": "screen-vision-workers",
    "ConsumerNamePrefix": "vision",
    "PayloadFieldName": "payload",
    "ApproximateMaxLength": 50000,
    "ReadBlockMilliseconds": 2000,
    "ReadCount": 8,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 50,
    "AutoClaimLoopDelaySeconds": 30,
    "StaleFrameAgeMs": 5000
  },

  "MarketplaceSettings": {
    "SoulApiBaseUrl": "http://127.0.0.1:5001/"
  },

  "OrganizationSettings": {
    "InviteBaseUrl": "http://localhost:3000",
    "InviteExpiryDays": 7
  },

  "RealtimeTextStream": {
    "StreamName": "synapse.llm.response",
    "ConsumerGroup": "text-delivery-workers"
  },
  
  "KeycloakSettings": {
    "Authority": "http://localhost:8080/realms/inktide",
    "Audience": "account",
    "RequireHttpsMetadata": false
  },

  "KeycloakAdminSettings": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8080",
    "Realm": "inktide-backend-admin",
    "ClientId": "CHANGE_ME__KEYCLOAK_ADMIN_CLIENT_ID",
    "ClientSecret": "CHANGE_ME__KEYCLOAK_ADMIN_CLIENT_SECRET"
  },

  "S3Settings": {
    "Enabled": true,
    "PublicBaseUrl": "",
    "ServiceUrl": "http://127.0.0.1:9000",
    "AccessKey": "CHANGE_ME__MINIO_ACCESS_KEY",
    "SecretKey": "CHANGE_ME__MINIO_SECRET_KEY",
    "DefaultBucket": "inktide-uploads",
    "ForcePathStyle": true,
    "Region": "us-east-1"
  },

  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:1420",
      "tauri://localhost"
    ]
  },
  
  "RedisSettings": {
    "BaseAddress": "127.0.0.1",
    "BasePort": 6379,
    "SyncTimeout": 2000,
    "ConnectTimeout": 2000,
    "AsyncTimeout": 10000
  },
  
  "PostgresSettings": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "CHANGE_ME__POSTGRES_DATABASE",
    "Username": "CHANGE_ME__POSTGRES_USERNAME",
    "Password": "CHANGE_ME__POSTGRES_PASSWORD",
    "MaxPoolSize": 200,
    "MinPoolSize": 10
  },
  
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  
  "SynapseIngestStreamSettings": {
    "StreamName": "synapse.ingest",
    "ConsumerGroup": "pipeline-workers",
    "ConsumerNamePrefix": "pipeline",
    "PayloadFieldName": "payload",
    "ApproximateMaxLength": 50000,
    "ReadBlockMilliseconds": 2000,
    "ReadCount": 16,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 50,
    "AutoClaimLoopDelaySeconds": 30
  },

  "DataProtection": {
    "MasterKey": "CHANGE_ME__DATA_PROTECTION_MASTER_KEY_32_BYTES_BASE64"
  },

  "TelegramSettings": {
    "FrontendBaseUrl": "http://localhost:3000"
  },

  "TwitchSettings": {
    "BotUsername": "InktideBot",
    "RedirectUri": "http://localhost:5001/api/connectors/twitch/callback",
    "FrontendBaseUrl": "http://localhost:3000"
  },

  "DiscordSettings": {
    "BotToken": "CHANGE_ME__DISCORD_BOT_TOKEN",
    "ClientId": "CHANGE_ME__DISCORD_CLIENT_ID",
    "ClientSecret": "CHANGE_ME__DISCORD_CLIENT_SECRET",
    "RedirectUri": "http://localhost:5001/api/connectors/discord/callback",
    "FrontendBaseUrl": "http://localhost:3000",
    "GuildIds": [],
    "ChannelIds": [],
    "IgnoreBots": true,
    "MaxReconnectAttempts": 10,
    "ReconnectBaseDelayMs": 1000
  },

  "EmotionClassificationOptions": {
    "OllamaBaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:1.5b",
    "TimeoutMs": 15000
  },

  "OllamaSettings": {
    "Host": "http://localhost",
    "Port": 11434,
    "EmbeddingModel": "nomic-embed-text"
  },
  
  "QdrantSettings": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "chat_memories"
  },

  "MemorySettings": {
    "IngestionBatchSize": 5,
    "IngestionBatchWindowMs": 3000,
    "IngestionChannelCapacity": 500,
    "RetentionDays": 90,
    "MinImportanceThreshold": 0.3,
    "ScribeBaseUrl": "http://localhost:8001"
  },

  "SynapseAggregation": {
    "LlmStreamName": "synapse.llm.ready",
    "ApproximateMaxLength": 10000
  },

  "LlmStream": {
    "StreamIn": "synapse.llm.ready",
    "StreamOut": "synapse.llm.response",
    "ConsumerGroup": "llm-workers",
    "ConsumerNamePrefix": "llm",
    "PayloadFieldName": "payload",
    "FallbackProviderId": "ollama",
    "ReadCount": 8,
    "ReadBlockMilliseconds": 2000,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 50,
    "AutoClaimLoopDelaySeconds": 30,
    "ApproximateMaxLength": 50000,
    "MaxConcurrentRequests": 1
  },

  "LlmResponseStream": {
    "StreamName": "synapse.llm.response",
    "ConsumerGroup": "tts-workers",
    "ConsumerNamePrefix": "tts",
    "PayloadFieldName": "payload",
    "ReadCount": 8,
    "ReadBlockMilliseconds": 2000,
    "AutoClaimMinIdleMs": 30000,
    "AutoClaimBatchSize": 20,
    "AutoClaimLoopDelaySeconds": 30,
    "DefaultVoiceId": "af_heart"
  },

  "TtsOutputStream": {
    "StreamName": "synapse.tts.ready",
    "ApproximateMaxLength": 5000,
    "PayloadFieldName": "payload"
  }


}