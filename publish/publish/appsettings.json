{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Inktide.API.Core"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/Logs/API/inktide-api-.log",
          "formatter": "Inktide.API.Core.Logging.CustomCompactJsonFormatter, Inktide.API.Core",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  
  "ChatProviders": {
    "DefaultProviderId": "echo",
    "FeatureFlags": {}
  },

  "TtsProviders": {
    "DefaultProviderId": "kokoro",
    "FeatureFlags": {},
    "Kokoro": {
      "Endpoint": "http://127.0.0.1:8880/v1"
    },
    "ElevenLabs": {
      "Endpoint": "https://api.elevenlabs.io",
      "DefaultModelId": "eleven_multilingual_v2"
    },
    "AzureSpeech": {
      "DefaultRegion": "eastus"
    },
    "GoogleCloudTts": {},
    "Cartesia": {
      "DefaultModel": "sonic-2"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5001"
      }
    }
  },

  "GrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8081,
    "CertPath": "",
    "CertPassword": ""
  },

  "SoulGrpcServerSettings": {
    "ListenAddress": "127.0.0.1",
    "ListenPort": 8084,
    "CertPath": "",
    "CertPassword": ""
  },
  
