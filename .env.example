# Copy to .env and fill in the blanks.
# Double-underscore maps to JSON nesting for .NET (PostgresSettings__Password → PostgresSettings.Password).

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=chimera
POSTGRES_USER=chimera
POSTGRES_PASSWORD=

KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=

# .NET overrides (same DB, different config path)
PostgresSettings__Host=localhost
PostgresSettings__Port=5432
PostgresSettings__Database=chimera
PostgresSettings__Username=chimera
PostgresSettings__Password=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# JWT validation (baked into the token by Keycloak, no client needed)
KeycloakSettings__Authority=http://localhost:8080/realms/chimera
KeycloakSettings__Audience=account
KeycloakSettings__RequireHttpsMetadata=false

# Admin API — only needed for avatar updates and account deletion from Keycloak
# Create a confidential client with service-account + manage-users role
KeycloakAdminSettings__Enabled=false
KeycloakAdminSettings__BaseUrl=http://localhost:8080
KeycloakAdminSettings__Realm=chimera
KeycloakAdminSettings__ClientId=
KeycloakAdminSettings__ClientSecret=

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

S3Settings__Enabled=true
S3Settings__ServiceUrl=http://127.0.0.1:9000
S3Settings__PublicBaseUrl=          # leave empty in dev; set CDN/public origin in prod
S3Settings__AccessKey=
S3Settings__SecretKey=
S3Settings__DefaultBucket=chimera-uploads

# ── Discord ───────────────────────────────────────────────────────────────────
DiscordSettings__BotToken=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chimera
VITE_KEYCLOAK_CLIENT_ID=chimera-web
VITE_API_URL=                       # empty = Vite proxy; set full origin in prod

# ── Python workers (fast-api/) ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5
OLLAMA_EMBED_MODEL=nomic-embed-text

REDIS_URL=redis://localhost:6379
REDIS_STREAM_IN=synapse.llm.ready
REDIS_STREAM_OUT=synapse.llm.response
REDIS_CONSUMER_GROUP=llm-workers
REDIS_CONSUMER_NAME=llm-worker-1
