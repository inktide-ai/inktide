# Wormhole — Environment variables
# Copy to .env and fill in values. For Docker/production, set these at runtime.

# ============== Chimera.ApiGateway ==============
# JWT signing secret (min 32 chars). Required for production.
# AUTH__SECRET=your-production-secret-min-32-chars

# Dev API key for testing (optional, dev only)
# AUTH__DEVAPIKEY=dev-api-key-for-testing

# PostgreSQL (override appsettings)
# PostgresSettings__Host=localhost
# PostgresSettings__Port=5432
# PostgresSettings__Database=chimera
# PostgresSettings__Username=chimera
# PostgresSettings__Password=chimera

# Redis
# RedisSettings__BaseAddress=127.0.0.1
# RedisSettings__BasePort=6379

# Reverse proxy: AI.Orchestrator backend (override appsettings)
# ReverseProxy__Clusters__ai-orchestrator__Destinations__default__Address=http://127.0.0.1:9090

# ============== Chimera.API (.NET) — override appsettings (double underscore = nested section) ==============
# PostgreSQL
# PostgresSettings__Database=
# PostgresSettings__Username=
# PostgresSettings__Password=
# POSTGRES_PASSWORD=   # alternative to PostgresSettings__Password (see InfrastructureStartup)

# RabbitMQ
# RabbitMqSettings__Username=
# RabbitMqSettings__Password=

# Discord bot (Connector.Discord)
# DiscordSettings__BotToken=

# Auth (JWT / signing — replace CHANGE_ME in appsettings)
# AuthSettings__Secret=
# AuthSettings__DevApiKey=

# Keycloak Admin API (replace CHANGE_ME__* in appsettings or set here; never commit real secrets)
# KeycloakAdminSettings__ClientId=
# KeycloakAdminSettings__ClientSecret=

# S3 / MinIO (when S3Settings__Enabled=true)
# S3Settings__AccessKey=
# S3Settings__SecretKey=
# S3Settings__PublicBaseUrl=   # optional; empty = derive from ServiceUrl

# OAuth (when Google/Twitch Enabled=true)
# OAuthSettings__Google__ClientId=
# OAuthSettings__Google__ClientSecret=
# OAuthSettings__Twitch__ClientId=
# OAuthSettings__Twitch__ClientSecret=

# ============== Web (Vite) ==============
# API base URL. Empty = use relative /api (dev proxy or same-origin)
# VITE_API_URL=
