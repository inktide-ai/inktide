# Copy this file to .env and fill in all values before starting.
# Double-underscore (__) maps to JSON nesting for .NET config:
#   PostgresSettings__Password  →  PostgresSettings:Password in ASP.NET

# ── Postgres ──────────────────────────────────────────────────────────────────
# Used by Docker Compose to create the database on first run.
POSTGRES_DB=inktide
POSTGRES_USER=inktide
POSTGRES_PASSWORD=

# Keycloak gets its own Postgres database (separate from the app DB).
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=

# .NET reads these directly — must match POSTGRES_* above.
PostgresSettings__Host=localhost
PostgresSettings__Port=5432
PostgresSettings__Database=inktide
PostgresSettings__Username=inktide
PostgresSettings__Password=

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Keycloak admin console credentials (Docker Compose).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# JWT validation — no client secret needed; Keycloak signs the token.
# Realm name must match what you created in the Keycloak admin console.
KeycloakSettings__Authority=http://localhost:8080/realms/chimera
KeycloakSettings__Audience=account
KeycloakSettings__RequireHttpsMetadata=false

# Admin API — required for avatar uploads and account deletion via Keycloak API.
# Create a confidential client in Keycloak with service-account + manage-users role.
# Set Enabled=false to skip (avatars and account deletion will be unavailable).
KeycloakAdminSettings__Enabled=false
KeycloakAdminSettings__BaseUrl=http://localhost:8080
KeycloakAdminSettings__Realm=chimera
KeycloakAdminSettings__ClientId=
KeycloakAdminSettings__ClientSecret=

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
# MinIO root credentials (Docker Compose). Also used as S3 access key below.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# S3-compatible storage for avatar uploads and assets.
# In production replace ServiceUrl with your S3/R2/etc. endpoint.
S3Settings__Enabled=true
S3Settings__ServiceUrl=http://127.0.0.1:9000
S3Settings__PublicBaseUrl=          # leave empty in dev; set CDN/public origin in prod
S3Settings__AccessKey=
S3Settings__SecretKey=
S3Settings__DefaultBucket=inktide-uploads

# ── Data Protection ───────────────────────────────────────────────────────────
# Used to encrypt persisted auth cookies and anti-forgery tokens.
# Generate: openssl rand -base64 32
# Must stay constant across restarts; rotating it invalidates all active sessions.
DataProtection__MasterKey=

# ── Auth ──────────────────────────────────────────────────────────────────────
# HMAC signing secret for internal auth tokens. Minimum 32 characters.
# Generate: openssl rand -base64 32
AuthSettings__SigningSecret=

# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token — Discord Developer Portal → Your App → Bot → Token.
DiscordSettings__BotToken=

# OAuth2 app credentials — Discord Developer Portal → Your App → OAuth2.
# Required for the Discord login / connector OAuth flow.
DiscordSettings__ClientId=
DiscordSettings__ClientSecret=
DiscordSettings__RedirectUri=http://localhost:5001/api/v1/connectors/discord/callback

# ── Twitch ────────────────────────────────────────────────────────────────────
# Twitch Developer Console → Your App → Client ID + Secret.
TwitchSettings__ClientId=
TwitchSettings__ClientSecret=

# Bot account OAuth token — generate via https://twitchapps.com/tmi/
TwitchSettings__BotOAuthToken=
TwitchSettings__BotUsername=
TwitchSettings__RedirectUri=http://localhost:5001/api/v1/connectors/twitch/callback
TwitchSettings__FrontendBaseUrl=http://localhost:3000

# ── SMTP ──────────────────────────────────────────────────────────────────────
# For dev: run `docker compose --profile dev up -d mailhog` and use Host=localhost Port=1025
# For prod: use a real SMTP provider (Gmail App Password, Mailgun, etc.)
SmtpSettings__Host=localhost
SmtpSettings__Port=1025
SmtpSettings__Username=
SmtpSettings__Password=
SmtpSettings__FromAddress=noreply@inktide.app
SmtpSettings__FromName=Inktide

# ── Billing ───────────────────────────────────────────────────────────────────
# Active payment provider: stripe | yookassa | robokassa
BillingSettings__ActiveProvider=stripe
BillingSettings__SuccessUrl=http://localhost:3000/billing/success
BillingSettings__CancelUrl=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
# Webhook secret: Stripe Dashboard → Webhooks → your endpoint → Signing secret.
StripeSettings__SecretKey=
StripeSettings__WebhookSecret=

# YooKassa — https://yookassa.ru/developers  (optional)
YooKassaSettings__ShopId=
YooKassaSettings__SecretKey=
YooKassaSettings__PriceAmount=299.00
YooKassaSettings__PriceCurrency=RUB
# IP allowlist for YooKassa webhook (empty = disabled). Add IPs from YooKassa docs in prod:
# YooKassaSettings__WebhookAllowedIps__0=185.71.76.0

# Robokassa — https://robokassa.com/Docs/  (optional)
RobokassaSettings__MerchantLogin=
RobokassaSettings__Password1=
RobokassaSettings__Password2=
RobokassaSettings__OutSum=299.00
RobokassaSettings__IsTest=true

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Origin the Next.js server proxies /hubs/* (SignalR) to. Required for a
# production build — next.config.ts refuses to build without it, so that an
# image can never ship silently pointing at localhost. Optional in dev, where
# it defaults to http://127.0.0.1:5001.
BACKEND_URL=http://127.0.0.1:5001

# Keycloak public vars — must match KeycloakSettings__Authority above.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=chimera
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=chimera-web

# Stripe publishable key — safe to expose to the browser.
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# API base URL — leave empty in dev (Next.js proxy handles /api → localhost:5001).
# Set full origin (e.g. https://api.inktide.app) in production.
NEXT_PUBLIC_API_URL=

# ── ngrok  (optional — for local webhook testing) ─────────────────────────────
# https://dashboard.ngrok.com/get-started/your-authtoken
# Run: docker compose --profile dev up -d ngrok
# Inspect: http://localhost:4040 | Public URL: docker compose logs ngrok
NGROK_AUTHTOKEN=

# ── Python workers (fast-api/) ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Ollama must be running locally or accessible at this URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5
OLLAMA_EMBED_MODEL=nomic-embed-text

# Redis stream config — must match SynapseIngestStreamSettings / LlmStream in appsettings.json.
REDIS_URL=redis://localhost:6379
REDIS_STREAM_IN=synapse.llm.ready
REDIS_STREAM_OUT=synapse.llm.response
REDIS_CONSUMER_GROUP=llm-workers
REDIS_CONSUMER_NAME=llm-worker-1
