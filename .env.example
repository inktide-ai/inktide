# Wormhole — Environment variables
# Copy to .env and fill in values. For Docker/production, set these at runtime.

# ============== Chimera.ApiGateway ==============
# JWT signing secret (min 32 chars). Required for production.
# AUTH__SECRET=your-production-secret-min-32-chars

# Dev API key for testing (optional, dev only)
# AUTH__DEVAPIKEY=dev-api-key-for-testing

# PostgreSQL (override appsettings)
# PostgresSettings__Host=localhost
# PostgresSettings__Port=5432
# PostgresSettings__Database=chimera
# PostgresSettings__Username=chimera
# PostgresSettings__Password=chimera

# Redis
# RedisSettings__BaseAddress=127.0.0.1
# RedisSettings__BasePort=6379

# ============== Web (Vite) ==============
# API base URL. Empty = use relative /api (dev proxy or same-origin)
# VITE_API_URL=
